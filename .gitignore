# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 없는 템플릿이라 비밀정보가 없음 — 통합 테스트 설정 안내용으로 커밋 대상에 포함
!.env.test.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated artifacts (not source — regenerate locally, don't commit)
/graphify-out/
/Project_Manual.pdf

# Playwright (E2E) — 로그인 상태 저장 파일 + 실행 결과물. 로그인 상태 파일은 실제 테스트
# 계정 세션(토큰)을 담고 있어 절대 커밋하지 않는다.
/playwright/.auth/
/playwright-report/
/test-results/
/blob-report/

# Supabase CLI 로컬 상태/캐시(project-ref, linked-project.json 등) — 머신별로 생성됨
supabase/.temp/
