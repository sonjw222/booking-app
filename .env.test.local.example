# 통합 테스트(tests/integration)에 필요한 환경변수 템플릿.
# 이 파일을 복사해 .env.test.local로 만들고 값을 채우세요.
# .env.test.local은 .gitignore의 .env* 규칙에 이미 포함되어 있어 커밋되지 않습니다.
#
#   cp .env.test.local.example .env.test.local
#
# GitHub Actions에서 실행할 때는 이 파일 대신 Repository Secrets에 동일한 이름으로
# 등록하면 됩니다(.github/workflows/test.yml 참고).

# 앱과 동일한 개발용 Supabase 프로젝트 정보 (운영 프로젝트에서 절대 실행하지 마세요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 통합 테스트 전용 계정 A/B — 없으면 자동 생성하고, 있으면 재사용합니다(get-or-create).
# Supabase Auth의 "Confirm email" 옵션이 켜져 있으면 가입 직후 바로 로그인이 안 되어
# 최초 1회 자동 생성이 실패할 수 있습니다 — 개발 프로젝트에서는 이 옵션을 꺼두는 것을 권장합니다.
TEST_USER_A_EMAIL=payment-test-a@example.com
TEST_USER_A_PASSWORD=changeme-A-1234
TEST_USER_B_EMAIL=payment-test-b@example.com
TEST_USER_B_PASSWORD=changeme-B-1234

# 통합 테스트가 주문을 생성할 실제 센터/상품.
# 운영 데이터가 아닌, 소액(또는 0원) 테스트 전용 상품을 하나 만들어 지정하는 것을 권장합니다.
TEST_CENTER_ID=
TEST_PRODUCT_ID=

# tests/integration/admin-assignment-security.test.ts 전용 — 관리자 직접배치/무료 추가 배치 테스트.
# TEST_USER_A/B와 동일하게 get-or-create 방식이라 값만 채우면 최초 실행 시 자동 가입됩니다.
# A와 B는 반드시 서로 다른 계정이어야 합니다("다른 센터 관리자는 차단" 검증에 사용).
TEST_MANAGER_A_EMAIL=admin-assign-test-manager-a@example.com
TEST_MANAGER_A_PASSWORD=changeme-MgrA-1234
TEST_MANAGER_B_EMAIL=admin-assign-test-manager-b@example.com
TEST_MANAGER_B_PASSWORD=changeme-MgrB-1234

# tests/integration/acl-003-permission-read.test.ts 전용 — ACL-003 서버 측 재검증(account_center_permissions
# SELECT RLS) 회귀 테스트. TEST_MANAGER_A와 같은 센터에 소속되는 권한 없는 일반 스태프 2명(get-or-create).
TEST_STAFF_A_EMAIL=acl-003-test-staff-a@example.com
TEST_STAFF_A_PASSWORD=changeme-StaffA-1234
TEST_STAFF_B_EMAIL=acl-003-test-staff-b@example.com
TEST_STAFF_B_PASSWORD=changeme-StaffB-1234

# 위 매니저 계정을 테스트 센터의 오너로 연결하는 fixture 준비(센터 생성, manager_centers 오너
# 역할 연결)에만 쓰는 서비스 역할 키. ⚠ 반드시 이 이름 그대로 두세요 — NEXT_PUBLIC_ 접두사를
# 붙이면 브라우저에 노출되는 값으로 취급되어 절대 안 됩니다. 이 키는 tests/integration/setup.ts
# 밖(app/, lib/)에서는 어디에도 쓰이지 않으며, 실제 admin_assign_reservation/admin_cancel_reservation
# RPC 호출과 권한 검증은 이 키가 아니라 항상 로그인 사용자별 일반 client로 실행합니다.
# Supabase 대시보드 → Project Settings → API → service_role key에서 확인할 수 있습니다.
# 절대 커밋하지 마세요(.env.test.local은 .gitignore에 포함되어 있음).
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 운영 Supabase 프로젝트가 생기면 그 URL을 여기 등록하세요.
# NEXT_PUBLIC_SUPABASE_URL이 이 값과 같으면 통합 테스트 실행 자체를 거부합니다(운영 DB 오발동 방지).
# 지금은 운영 프로젝트가 따로 없으므로 비워둬도 됩니다.
PRODUCTION_SUPABASE_URL=
