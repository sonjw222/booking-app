# 앱(app/, lib/) 실행에 필요한 환경변수 템플릿.
# 이 파일을 복사해 .env.local을 만들고 값을 채우세요.
# .env.local은 .gitignore의 .env* 규칙에 이미 포함되어 있어 커밋되지 않습니다.
#
#   cp .env.local.example .env.local
#
# 통합 테스트(tests/integration) 전용 환경변수는 .env.test.local.example을 따로 참고하세요.

# 필수 — 없으면 앱이 시작되지 않습니다.
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 선택 — 네이버/카카오 소셜 로그인. 비워두면 로그인 화면의 해당 버튼이
# "설정이 아직 안 되어 있어요" 에러를 보여줄 뿐 앱 자체는 정상 동작합니다.
# 값을 발급받는 절차는 AUTH_SETUP.md 참고.
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 선택 — 결제 프로바이더. 비워두면 mock으로 동작합니다(app/checkout에서 실제 결제 없이
# 성공/실패/취소 시나리오를 흉내냄). "toss" 또는 "portone"만 유효한 값이고, 그 외 값은
# 전부 mock으로 처리됩니다. lib/payments/PaymentProviderFactory.ts 참고.
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# NEXT_PUBLIC_PAYMENT_PROVIDER=toss일 때만 필요. 토스페이먼츠 개발자센터
# (developers.tosspayments.com) → 내 개발정보 → 반드시 "API 개별 연동 키" 섹션에서 확인
# (⚠ "주문서형·결제창형 연동 키"=test_gck_docs_.../test_gsk_docs_...는 "결제위젯"(인라인 UI)
# 전용이라 이 프로젝트가 쓰는 payment().requestPayment() 팝업 방식에는 안 맞음 — 실측 확인,
# NotSupportedWidgetKeyError로 즉시 실패함). API 개별 연동 키는 사업자 심사 없이 개발자센터
# 가입만으로 바로 발급되는 테스트 키(test_ck_.../test_sk_...)라 지금 개발 단계에 그대로 씀,
# 실제 전자결제 신청 후 운영 키로 교체.
# TOSS_SECRET_KEY는 서버(app/api/payments/*)에서만 쓰이는 시크릿이라 NEXT_PUBLIC_ 접두사가
# 없습니다 — 절대 브라우저에 노출되면 안 됩니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# app/api/payments/* 서버 라우트가 confirm_real_payment RPC를 호출할 때 씁니다(RLS 우회
# 필요 — 결제 승인은 이미 토스 서버가 검증한 뒤라 신뢰 가능한 서버 경로). Supabase 대시보드
# → Project Settings → API → service_role secret. 유출되면 전체 DB가 뚫리므로 각별히 주의.
SUPABASE_SERVICE_ROLE_KEY=

# 선택 — mock 결제 시 강제할 결과 시나리오. "success" | "failed" | "cancelled".
# 비워두면 success. checkout 화면의 ?mockScenario= 쿼리로 재빌드 없이 즉시 덮어쓸 수 있습니다.
NEXT_PUBLIC_PAYMENT_SCENARIO=

# 선택 — 웹 푸시 구독에 쓰는 VAPID 공개키(lib/webPush.ts). 비워두면 빈 문자열로 처리되어
# 웹 푸시 구독 시도 시 실패합니다. supabase/functions/send-web-push가 발송을 담당하며,
# 이 키와 짝을 이루는 비공개키는 여기 두지 않고 Supabase Edge Function 환경변수로 등록합니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
