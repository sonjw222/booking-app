<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+(API 31) 전용 오버라이드.

      API 31부터는 OS 자체의 SplashScreen API가 앱 프로세스가 뜨기 전에 자기 배경을
      먼저 그린다. 이 파일이 없으면 windowSplashScreenBackground 기본값(흰색)이 잠깐
      노출된 뒤에야 기존 Capacitor WebView 스플래시(드로어블 splash.png, 네이비)가
      떠서 화면이 한 번 번쩍인다.

      android:windowSplashScreenBackground를 네이비로 지정해 그 번쩍임을 없앤다.
      #0A2545는 app/globals.css의 brand 토큰(변수명 brand, 하이픈 두 개 CSS 커스텀
      프로퍼티 표기 생략) 값이자 drawable/splash.png의 실제 배경색(RGB 10,37,70)과
      동일해, 기존 스플래시/브랜드 톤과 연속성이 유지된다.
      windowSplashScreenAnimatedIcon은 지정하지 않음 — 지정하지 않으면 플랫폼이
      android:icon(런처 아이콘)을 자동으로 써서, 기존에 보이던 "동그란 앱 아이콘"
      모양은 그대로 유지되고 이번에 신고된 배경색 문제만 고친다.

      API 30 이하 기기는 이 폴더(values-v31)가 적용되지 않으므로 기존 동작에
      영향 없음.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 릴리스 폴리시 배치 8차(2026-09-17), 14번 — API 31+에서는 windowSplashScreenBackground
             (아래, 단색)가 실제로 그려지는 값이라 이 android:background는 평소엔 안 보이지만,
             혹시라도 쓰이는 경로가 있을 때를 대비해 태블릿에서 로고가 늘어나 보이던 원인과
             같은 값(@drawable/splash 원본 비트맵 직접 참조)을 계속 두지 않는다 — base
             values/styles.xml과 동일하게 늘리지 않는 wrapper로 통일(values/colors.xml의
             splashBackground 주석 참고). -->
        <item name="android:background">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">#0A2545</item>
        <!-- 태블릿 실기기 QA(2026-09-21) — values/styles.xml의 같은 이름 스타일에 남긴
             설명 참고. API 31+에서는 이 파일이 우선 적용되므로 여기도 동일하게 추가해야
             실제 기기(Android 13, API 33)에서 네이티브 ActionBar가 사라진다. 실제로
             뜨는 게 AppCompat 컴팻 ActionBar가 아니라 프레임워크 네이티브 ActionBar라
             android: 접두사 붙은 프레임워크 속성도 반드시 같이 필요하다(같은 파일
             윗부분 큰 주석 참고). -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
