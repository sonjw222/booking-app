<?xml version="1.0" encoding="utf-8"?>
<!--
  릴리스 폴리시 배치 8차(2026-09-17), 14번 — values/colors.xml의 splashBackground 주석
  참고. 기존 drawable/splash.png(및 density/orientation/night 변형들)를 그대로
  재사용하되(신규 asset 생성 금지), android:gravity="center"로 감싸 화면 종횡비와 무관하게
  "늘리지 않고 원본 크기 그대로 중앙 배치"한다 — 태블릿처럼 훨씬 넓고 짧은 화면에서도
  로고가 찌그러지지 않는다. 뒤(첫 레이어)는 이미지 바깥 여백을 기존과 동일한 브랜드
  네이비로 채운다(이미지 자체도 같은 색 배경이라 이어붙는 경계가 안 보임).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground" />
    <item>
        <bitmap
            android:src="@drawable/splash"
            android:gravity="center" />
    </item>
</layer-list>
