<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NICEPAY v3 앱(WebView) 결제: Android 11+ 에서 카드사 앱을 호출(resolve)하려면 대상 패키지를 선언해야 한다(공식 문서 "3rd 앱 호출 등록"). 신용카드·공동인증·백신 구분만 — 소셜 로그인과 겹치는 앱은 제외.
         NicepayAppReturn.java 의 CARD_APP_PACKAGES 와 같은 목록(테스트가 고정). -->
    <queries>
        <package android:name="kr.co.samsungcard.mpocket" />
        <package android:name="net.ib.android.smcard" />
        <package android:name="com.shcard.smartpay" />
        <package android:name="com.shinhancard.smartshinhan" />
        <package android:name="com.shinhan.smartcaremgr" />
        <package android:name="com.hyundaicard.appcard" />
        <package android:name="com.kbcard.cxh.appcard" />
        <package android:name="com.kbstar.kbbank" />
        <package android:name="com.kbstar.reboot" />
        <package android:name="kvp.jjy.MispAndroid320" />
        <package android:name="com.hanaskcard.paycla" />
        <package android:name="kr.co.hanamembers.hmscustomer" />
        <package android:name="com.lcacApp" />
        <package android:name="com.lottemembers.android" />
        <package android:name="nh.smart.nhallonepay" />
        <package android:name="com.wooricard.smartapp" />
        <package android:name="com.wooribank.smart.npib" />
        <package android:name="kr.co.citibank.citimobile" />
        <package android:name="com.kakaobank.channel" />
        <package android:name="com.hanaskcard.rocomo.potal" />
        <package android:name="com.lumensoft.touchenappfree" />
        <package android:name="com.TouchEn.mVaccine.webs" />
        <package android:name="com.ahnlab.v3mobileplus" />
        <package android:name="kr.co.shiftworks.vguardweb" />
    </queries>

    <!-- 보안 감사(2026-10-08): allowBackup을 끈다. 백업 규칙(fullBackupContent/dataExtractionRules)이 없어 true면 앱 데이터 전체 — WebView localStorage에 있는 Supabase
         세션 토큰 포함 — 가 클라우드 백업/기기 이전에 실린다. 이 앱은 호스팅된 사이트(server.url)를 띄우고 실제 데이터는 전부 서버에 있어 로컬 백업이 필요 없다
         (재설치/새 기기에서는 다시 로그인하면 된다). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 실기기 QA(2026-09-14, 4차) — 키보드가 열릴 때 입력창이 가려지지 않도록 콘텐츠
                 영역이 줄어들게 한다(Android 공식 키보드 마이그레이션 가이드 권장 —
                 developer.android.com/develop/ui/views/layout/sw-keyboard). MainActivity.java의
                 WindowInsetsCompat.Type.ime() 리스너와 함께 동작. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- NICEPAY v3 앱 결제 복귀(WapUrl/IspCancelUrl) deep link — 제안 scheme(미확정): NICEPAY 기술지원 확인 + 사용자 승인 전에는 서버 설정이 꺼져 있어 이 scheme 으로 오는 URL 이 없다.
                 이 Activity 는 이미 exported(LAUNCHER)다 — 들어온 URL 은 NicepayAppReturn.parse 로 정확한 형식(host=nicepay, /wap|/cancel, orderId=uuid)만 통과시키고 아무 URL 도 로드하지 않는다(열 화면은 서버의 결제 결과 화면뿐).
                 NicepayAppReturn.java SCHEME · ios Info.plist · lib/payments/nicepayAppReturn.ts 와 같은 값. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mwhabitnicepay" android:host="nicepay" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 백그라운드 heads-up 실기기 QA(2026-09-21) — 이 값이 없으면 Firebase
             Messaging이 알림 payload에 채널 지정이 없을 때 자체 fallback 채널
             (IMPORTANCE_DEFAULT, heads-up 안 뜸)을 씀. MainActivity.java에서 만드는
             NOTIFICATION_CHANNEL_ID(IMPORTANCE_HIGH)와 문자열이 정확히 일치해야 한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mwhabit_default" />

        <!-- 알림 아이콘 실기기 QA(2026-09-21) — production payload가 Android는 항상
             data-only라 실제로는 MwhabitMessagingService가 직접 만든 알림만 뜨지만,
             혹시 어딘가에서 "notification" 키가 있는 payload가 들어와도(예: 다른 발송
             경로, Firebase Console 캠페인) 최소한 풀컬러 런처 아이콘이 알파로 뭉개지는
             일은 없도록 방어적으로 지정한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/splashBackground" />

        <!-- 알림 아이콘 실기기 QA(2026-09-21) — Capacitor push-notifications 플러그인이
             자기 AAR 매니페스트로 등록하는 기본 FirebaseMessagingService(MessagingService)를
             지우고, 그걸 상속해 large icon 알림을 직접 만드는 MwhabitMessagingService로
             대체한다. 앱 하나엔 FirebaseMessagingService가 하나만 있어야 하므로(intent-filter
             중복 시 어느 쪽이 호출될지 보장 안 됨) 반드시 remove 후 등록해야 한다. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".MwhabitMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>